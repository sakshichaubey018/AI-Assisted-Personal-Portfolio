# ─────────────────────────────────────────────────────────────
#  Sakshi Portfolio — Environment Variables
# ─────────────────────────────────────────────────────────────
#
#  Copy this file to `.env` (never commit .env to git):
#    cp .env.example .env
#
#  Then add your OpenAI API key below.
#  Get one at: https://platform.openai.com/api-keys
#
#  The chatbot uses GPT-4o-mini by default.
#  If VITE_OPENAI_KEY is not set, the widget runs in 
#  demo mode with smart pre-built responses.
# ─────────────────────────────────────────────────────────────

VITE_OPENAI_KEY=sk-your-openai-api-key-here
